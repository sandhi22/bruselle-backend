# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# MongoDB Atlas connection string (free tier)
# Get this from https://www.mongodb.com/cloud/atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/bruselle

# Password required to use the admin panel (add/edit/delete products)
# Pick your own secret value here
ADMIN_KEY=change-this-to-a-real-secret

# Port the server runs on locally (hosting providers usually set this automatically)
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
# Add your GitHub Pages / Vercel / Netlify URL here once deployed
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
